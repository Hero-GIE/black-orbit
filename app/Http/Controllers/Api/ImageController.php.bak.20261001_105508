<?php

namespace App\Http\Controllers\Api;

use App\Http\Controllers\Controller;
use App\Services\ActivityLogger;
use App\Services\ImageService;
use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;
use Illuminate\Support\Facades\Log;

class ImageController extends Controller
{
    protected ImageService $imageService;

    public function __construct(ImageService $imageService)
    {
        $this->imageService = $imageService;
    }

    public function upload(Request $request): JsonResponse
    {
        try {
            if (!$request->hasFile('image')) {
                return response()->json([
                    'success' => false,
                    'error'   => 'No file uploaded',
                    'message' => 'The "image" field is missing or was not received by the server.',
                ], 400);
            }

            $file = $request->file('image');

            if (!$file->isValid()) {
                Log::warning('ImageController@upload: invalid upload', [
                    'error'     => $file->getError(),
                    'error_msg' => $file->getErrorMessage(),
                ]);

                return response()->json([
                    'success' => false,
                    'error'   => 'Upload failed',
                    'message' => $file->getErrorMessage(),
                    'code'    => $file->getError(),
                ], 400);
            }

            $userId = $request->input('user_id')
                ?? data_get($request->input('firebase_user'), 'uid')
                ?? 'test_user';
            $folder = $request->input('folder', 'general');

            $result = $this->imageService->upload($file, $userId, $folder);

            try {
                ActivityLogger::log(
                    'admin_action',
                    'Image uploaded',
                    'Uploaded to ' . ($result['path'] ?? 'unknown'),
                    ['folder' => $folder]
                );
            } catch (\Throwable $e) {
                Log::warning('ActivityLogger failed on upload', [
                    'message' => $e->getMessage(),
                ]);
            }

            return response()->json([
                'success' => true,
                'data'    => $result,
                'message' => 'Image uploaded successfully',
            ], 200);

        } catch (\Throwable $e) {
            Log::error('ImageController@upload failed', [
                'message' => $e->getMessage(),
                'file'    => $e->getFile(),
                'line'    => $e->getLine(),
            ]);

            return response()->json([
                'success' => false,
                'error'   => 'Upload failed',
                'message' => $e->getMessage(),
            ], 500);
        }
    }

    public function uploadMultiple(Request $request): JsonResponse
    {
        try {
            if (!$request->hasFile('images')) {
                return response()->json([
                    'success' => false,
                    'error'   => 'No files uploaded',
                    'message' => 'The "images" field is missing or empty.',
                ], 400);
            }

            $userId = $request->input('user_id')
                ?? data_get($request->input('firebase_user'), 'uid')
                ?? 'test_user';
            $folder = $request->input('folder', 'general');
            $files  = $request->file('images');

            $results = [];
            foreach ($files as $file) {
                if (!$file->isValid()) {
                    Log::warning('ImageController@uploadMultiple: invalid file', [
                        'error'     => $file->getError(),
                        'error_msg' => $file->getErrorMessage(),
                    ]);
                    continue;
                }

                $results[] = $this->imageService->upload($file, $userId, $folder);
            }

            try {
                ActivityLogger::log(
                    'admin_action',
                    'Images uploaded',
                    count($results) . ' images uploaded',
                    ['folder' => $folder]
                );
            } catch (\Throwable $e) {
                Log::warning('ActivityLogger failed on uploadMultiple', [
                    'message' => $e->getMessage(),
                ]);
            }

            return response()->json([
                'success' => true,
                'data'    => $results,
                'message' => count($results) . ' images uploaded successfully',
            ], 200);

        } catch (\Throwable $e) {
            Log::error('ImageController@uploadMultiple failed', [
                'message' => $e->getMessage(),
                'file'    => $e->getFile(),
                'line'    => $e->getLine(),
            ]);

            return response()->json([
                'success' => false,
                'error'   => 'Upload failed',
                'message' => $e->getMessage(),
            ], 500);
        }
    }

    public function delete(Request $request): JsonResponse
    {
        try {
            $path = $request->input('path');

            if (!$path || !is_string($path)) {
                return response()->json([
                    'success' => false,
                    'error'   => 'Invalid path',
                    'message' => 'A "path" string is required.',
                ], 400);
            }

            $userId = $request->input('user_id')
                ?? data_get($request->input('firebase_user'), 'uid')
                ?? 'test_user';

            if (!str_starts_with($path, "uploads/{$userId}/")) {
                return response()->json([
                    'success' => false,
                    'error'   => 'Forbidden',
                    'message' => 'You can only delete your own files',
                ], 403);
            }

            $this->imageService->delete($path, $userId);

            try {
                ActivityLogger::log('admin_action', 'Image deleted', 'Deleted ' . $path);
            } catch (\Throwable $e) {
                Log::warning('ActivityLogger failed on delete', [
                    'message' => $e->getMessage(),
                ]);
            }

            return response()->json([
                'success' => true,
                'message' => 'Image deleted successfully',
            ], 200);

        } catch (\Throwable $e) {
            Log::error('ImageController@delete failed', [
                'message' => $e->getMessage(),
                'file'    => $e->getFile(),
                'line'    => $e->getLine(),
            ]);

            return response()->json([
                'success' => false,
                'error'   => 'Delete failed',
                'message' => $e->getMessage(),
            ], 500);
        }
    }

    public function list(Request $request): JsonResponse
    {
        try {
            $userId = $request->input('user_id')
                ?? data_get($request->input('firebase_user'), 'uid')
                ?? 'test_user';
            $limit  = (int) $request->input('limit', 50);
            $offset = (int) $request->input('offset', 0);

            $result = $this->imageService->getUserImages($userId, $limit, $offset);

            return response()->json([
                'success' => true,
                'data'    => $result['data'],
                'meta'    => [
                    'total'  => $result['total'],
                    'limit'  => $limit,
                    'offset' => $offset,
                ],
            ], 200);

        } catch (\Throwable $e) {
            Log::error('ImageController@list failed', [
                'message' => $e->getMessage(),
                'file'    => $e->getFile(),
                'line'    => $e->getLine(),
            ]);

            return response()->json([
                'success' => false,
                'error'   => 'Failed to list images',
                'message' => $e->getMessage(),
            ], 500);
        }
    }

    public function getUrl(Request $request): JsonResponse
    {
        try {
            $path = $request->input('path');

            if (!$path || !is_string($path)) {
                return response()->json([
                    'success' => false,
                    'error'   => 'Invalid path',
                    'message' => 'A "path" string is required.',
                ], 400);
            }

            $url = $this->imageService->getImageUrl($path);

            return response()->json([
                'success' => true,
                'data'    => [
                    'url'  => $url,
                    'path' => $path,
                ],
            ], 200);

        } catch (\Throwable $e) {
            Log::error('ImageController@getUrl failed', [
                'message' => $e->getMessage(),
                'file'    => $e->getFile(),
                'line'    => $e->getLine(),
            ]);

            return response()->json([
                'success' => false,
                'error'   => 'Failed to get URL',
                'message' => $e->getMessage(),
            ], 500);
        }
    }
}
